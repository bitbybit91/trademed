# TradeMed Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ===== Database Configuration =====
# PostgreSQL connection string
DATABASE_URL=postgresql://trademed_user:your_secure_password@localhost/trademed_production

# ===== Rails Configuration =====
# Generate with: bundle exec rake secret
SECRET_KEY_BASE=generate_a_128_character_hex_string_here

# Rails environment
RAILS_ENV=production
RACK_ENV=production

# ===== Site Configuration =====
# Your market name
SITENAME=My TradeMed Market

# Admin hostname (can be your main onion address or a separate admin onion address)
ADMIN_HOSTNAME=your_onion_address.onion

# Logo filename in app/assets/images/ (optional)
LOGO_FILENAME=logo.png

# ===== Bitcoin Configuration =====
# Bitcoin RPC connection for market server (watch-only wallet)
MARKET_BITCOIND_URI=http://bitcoinrpc:your_rpc_password@127.0.0.1:8332

# Bitcoin RPC connection for payment server (full wallet with private keys)
# Only needed on payment server
# PAYOUT_BITCOIND_URI=http://bitcoinrpc:your_rpc_password@127.0.0.1:8332

# Litecoin support (optional)
# MARKET_LITECOIND_URI=http://litecoinrpc:your_rpc_password@127.0.0.1:9332
# PAYOUT_LITECOIND_URI=http://litecoinrpc:your_rpc_password@127.0.0.1:9332

# Number of blockchain confirmations required before order marked as paid
BLOCKCHAIN_CONFIRMATIONS=3

# Bitcoin address labeling (optional, for organization)
BITCOIND_ORDER_ADDRESS_LABEL=trademed_orders
BITCOIND_WATCH_ADDRESS_LABEL=trademed_watch

# Number of transactions to check per address (adjust based on order volume)
LISTTRANSACTIONS_COUNT=200

# ===== GPG/PGP Configuration =====
# Your GPG key ID (for signing payment addresses)
GPG_KEY_ID=YOUR_GPG_KEY_ID_HERE

# ===== API Configuration =====
# Admin API key - generate a long random string (64+ characters)
ADMIN_API_KEY=generate_a_long_random_string_here

# Admin API URI base (for payment server to connect to market server)
# Only needed on payment server
# ADMIN_API_URI_BASE=http://your_admin_onion.onion

# ===== TOR Configuration =====
# TOR proxy settings (for payment server to connect to market server via TOR)
# Only needed on payment server
# TOR_PROXY_HOST=127.0.0.1
# TOR_PROXY_PORT=9050

# ===== Currency Configuration =====
# Space-separated list of supported currency codes
CURRENCIES=USD EUR GBP CAD AUD CNY

# ===== Security Configuration =====
# Random salt for hashing buyer display names in feedback
# Generate with: openssl rand -hex 32
DISPLAYNAME_HASH_SALT=generate_a_random_salt_here

# ===== Order Configuration =====
# Time in seconds before unpaid orders expire (default: 12 hours = 43200 seconds)
EXPIRE_UNPAID_ORDER_DURATION=43200

# Rate limit: max orders per hour per buyer (to prevent abuse)
ORDERS_PER_HOUR_THRESHOLD=5

# Days to hide prices on old reviews (for vendor privacy, or leave blank)
ORDER_AGE_TO_HIDE_PRICE_ON_REVIEW=120

# ===== Multi-Vendor Configuration =====
# Commission percentage for multi-vendor markets (0.00 for single vendor)
COMMISSION=0.00

# Enable vendor registration form (false for single vendor)
# ENABLE_VENDOR_REGISTRATION_FORM=true

# Require PGP keys for all user accounts
# ENABLE_MANDATORY_PGP_USER_ACCOUNTS=true

# Enable support ticket system (for multi-vendor markets)
# ENABLE_SUPPORT_TICKETS=true
